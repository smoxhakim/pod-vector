# Postgres (used by packages/db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/podvector

# Redis (BullMQ broker)
REDIS_URL=redis://localhost:6380

# Cloudflare R2 (S3-compatible). Bucket must be private, with a CORS rule allowing
# GET/PUT/HEAD + content-type from the web origin — see README "Storage setup".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pod-vector-studio-dev
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Auth.js — generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3100

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Resend (transactional email). Unset = magic links are logged to the web console (dev only).
RESEND_API_KEY=

# Sentry
SENTRY_DSN=

# Third-party (Phase 2+)
CLIPDROP_API_KEY=
