# Postgres (used by packages/db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/podvector

# Redis (BullMQ broker)
REDIS_URL=redis://localhost:6380

# Cloudflare R2 / S3-compatible storage (MinIO locally)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=pod-vector-studio
R2_ENDPOINT=http://localhost:9000

# Auth.js
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Resend (transactional email)
RESEND_API_KEY=

# Sentry
SENTRY_DSN=

# Third-party (Phase 2+)
CLIPDROP_API_KEY=
